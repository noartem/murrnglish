# Session artifacts (omp)
/hub
/help.txt

# Dependencies, build artifacts, caches
node_modules/
dist/
*.local
*.tsbuildinfo
__pycache__/

# Generated by scripts/sync_books.mjs (run by predev/prebuild/pretest):
# every book's served files and the app's book registry
/public/books/
/src/generated/

# API keys (the red book's LLM pipeline reads books/red/.env)
.env

# Per-book session artifacts (screenshots, logs, reports, one-off scripts)
books/*/work/*.png
books/*/work/*.log
books/*/work/*.txt
books/*/work/*.py

# Extracted book artifacts: only plain page text is tracked (validator
# ground truth for coverage checks); block text and the split key stay local
books/*/work/pages/blocks/
books/*/work/key/
