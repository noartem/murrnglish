      "id": "66.1",
      "type": "write",
      "instruction": "Write sentences using afraid to … or afraid of -ing.",
      "items": [
        {
          "num": 1,
          "prompt": "The streets here are not safe at night. (a lot of people / afraid / go / out)",
          "answers": [
            "A lot of people are afraid to go out."
          ]
        },
        {
          "num": 2,
          "prompt": "We walked very carefully along the icy path. (we / afraid / fall)",
          "answers": [
            "We were afraid of falling."
          ]
        },
        {
          "num": 3,
          "prompt": "I don’t usually carry my passport with me. (I / afraid / lose / it)",
          "answers": [
            "I’m afraid of losing it."
          ]
        },
        {
          "num": 4,
          "prompt": "I thought she would be angry if I told her what had happened. (I / afraid / tell / her)",
          "answers": [
            "I was afraid to tell her."
          ]
        },
        {
          "num": 5,
          "prompt": "We ran to the station. (we / afraid / miss / our train)",
          "answers": [
            "We were afraid of missing our train."
          ]
        },
        {
          "num": 6,
          "prompt": "In the middle of the film there was a very horrifying scene. (we / afraid / look)",
          "answers": [
            "We were afraid to look."
          ]
        },
        {
          "num": 7,
          "prompt": "The vase was very valuable, so I held it carefully. (I / afraid / drop / it)",
          "answers": [
            "I was afraid of dropping it."
          ]
        },
        {
          "num": 8,
          "prompt": "If there’s anything you want to know, you can ask me. (don’t / afraid / ask)",
          "answers": [
            "Don’t be afraid to ask."
          ]
        },
        {
          "num": 9,
          "prompt": "I was worried because we didn’t have much petrol. (I / afraid / run out of petrol)",
          "answers": [
            "I was afraid of running out of petrol."
          ]
        }
      ]
    },
