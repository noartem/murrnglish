      "id": "92.2",
      "type": "write",
      "instruction": "Make one sentence from two. Use who/that/which.",
      "items": [
        {
          "num": 1,
          "prompt": "A girl was injured in the accident. She is now in hospital.",
          "answers": [
            "The girl who was injured in the accident is now in hospital."
          ]
        },
        {
          "num": 2,
          "prompt": "A waiter served us. He was impolite and impatient.",
          "answers": [
            "The waiter who/that served us was impolite and impatient."
          ]
        },
        {
          "num": 3,
          "prompt": "A building was destroyed in the fire. It has now been rebuilt.",
          "answers": [
            "The building that/which was destroyed in the fire has now been rebuilt."
          ]
        },
        {
          "num": 4,
          "prompt": "Some people were arrested. They have now been released.",
          "answers": [
            "The people who/that were arrested have now been released."
          ]
        },
        {
          "num": 5,
          "prompt": "A bus goes to the airport. It runs every half hour.",
          "answers": [
            "The bus that/which goes to the airport runs every half hour."
