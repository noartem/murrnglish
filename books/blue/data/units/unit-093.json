  "exercises": [
    {
      "id": "93.1",
      "type": "write",
      "instruction": "In some of these sentences you need who or that. Correct the sentences where necessary.",
      "items": [
        {
          "num": 1,
          "prompt": "The woman lives next door is a doctor.",
          "answers": [
            "The woman who lives next door is a doctor."
          ]
        },
        {
          "num": 2,
          "prompt": "Did you find the keys you lost?",
          "answers": [
            "OK"
          ]
        },
        {
          "num": 3,
          "prompt": "The people we met last night were very friendly.",
          "answers": [
            "OK",
            "The people who/that we met last night were very friendly."
          ]
        },
        {
          "num": 4,
          "prompt": "The people work in the office are very friendly.",
          "answers": [
            "The people who/that work in the office are very friendly."
          ]
        },
        {
          "num": 5,
          "prompt": "I like the people I work with.",
          "answers": [
            "OK",
            "I like the people who/that I work with."
          ]
        },
        {
          "num": 6,
          "prompt": "What have you done with the money I gave you?",
          "answers": [
            "OK",
            "What have you done with the money that/which I gave you?"
          ]
        },
        {
          "num": 7,
          "prompt": "What happened to the money was on the table?",
          "answers": [
            "What happened to the money that/which was on the table?"
          ]
        },
        {
          "num": 8,
          "prompt": "What’s the worst film you’ve ever seen?",
          "answers": [
            "OK",
            "What’s the worst film that/which you’ve ever seen?"
          ]
        },
        {
          "num": 9,
          "prompt": "What’s the best thing it has ever happened to you?",
          "answers": [
            "What’s the best thing that/which has ever happened to you?"
          ]
        }
      ]
    },
