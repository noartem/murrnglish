      {"id":"sit-down","en":"sit down","ru":"сесть","ex":"Please sit down.","unit":142},
      {"id":"bend-down","en":"bend down","ru":"нагнуться","ex":"I bent down to tie my shoelace.","unit":142},
      {"id":"lie-down","en":"lie down","ru":"лечь","ex":"I’m tired. I’m going to lie down.","unit":142},
